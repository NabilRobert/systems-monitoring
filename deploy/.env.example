# Copy to deploy/.env on the server and fill in. Never commit .env.

# A name for the server in alert messages. Not its real hostname.
HOST_LABEL=server-1

# Listening ports that are expected. A bare port allows any address;
# ADDR:PORT allows one address. Loopback listeners are ignored.
SECURITY_ALLOWED_PORTS=22,80,443

# SSH logins from these networks arrive silently (ticket) instead of
# buzzing (page). Leave empty to page on every login.
SECURITY_KNOWN_NETWORKS=

# The failed-login thresholds and windows are numbers in
# vector/vector.yaml (burst_groups, flood_groups), not settings here:
# Vector doesn't read environment variables inside its config file.

# The group ID that can read /var/log/auth.log (used by compose).
AUTH_LOG_GID=4
