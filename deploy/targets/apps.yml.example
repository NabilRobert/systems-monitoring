# Copy to deploy/targets/apps.yml on the server and fill in the domains.
# apps.yml is git-ignored: the repo names no server or domain.
# Juku is added once it is live. Every target is https, so each also gets
# the certificate check (tests/test_targets.py).
- targets: ["https://<mcp-backbone-domain>/healthz"]
  labels:
    app: mcp-backbone
- targets: ["https://<pitstop-demo-domain>/api/health"]
  labels:
    app: pitstop-demo
# Framed has no health route. Its Node server answers "/" itself (not
# Caddy from disk), so a stopped container fails the probe; Cloudflare's
# own error pages for a down origin are 5xx, never 200.
- targets: ["https://<framed-domain>/"]
  labels:
    app: framed
